# =============================================================================
# Millennium Nexus — ambiente LOCAL (copie para .env.local)
# Gerado parcialmente por: npm run local:up
# =============================================================================

# Supabase local (supabase start — Docker)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:15021
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para /api/cron/push (Task Scheduler) — troque por valor aleatório longo
CRON_SECRET=change-me-to-a-long-random-string

# --- Modo túnel (Cloudflare / Tailscale Funnel) — preenchido por npm run tunnel:env ---
# URL pública do túnel (ex.: https://abc.trycloudflare.com)
# NEXT_PUBLIC_APP_URL=
# Supabase via proxy do Next (não exponha :15021 na internet)
# NEXT_PUBLIC_SUPABASE_URL=/supabase-api
# Conexão direta servidor → Supabase local (não altere manualmente no tunel)
# SUPABASE_INTERNAL_URL=http://127.0.0.1:15021
# Porta extra antes do login do app — link: https://.../?tunnel_token=...
# TUNNEL_ACCESS_TOKEN=

# Web Push (VAPID) — reuse da cloud ou gere novas keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pedro.phdois@gmail.com
